{
  "opencollection": "1.0.0",
  "info": {
    "name": "Signeasy Embedded Users API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.signeasy.com/v3/me/"
          },
          "docs": "Fetch the authenticated user's details, including remaining envelope credits."
        }
      ]
    }
  ],
  "bundled": true
}